####### Install

install_target: all FORCE
	@if not exist C:$(INSTALL_ROOT)\Qwt-6.2.0\lib mkdir C:$(INSTALL_ROOT)\Qwt-6.2.0\lib & if not exist C:$(INSTALL_ROOT)\Qwt-6.2.0\lib exit 1
	-$(INSTALL_FILE) ..\lib\qwt.lib C:$(INSTALL_ROOT)\Qwt-6.2.0\lib\qwt.lib
	-$(INSTALL_FILE) $(DESTDIR_TARGET) C:$(INSTALL_ROOT)\Qwt-6.2.0\lib\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT)\Qwt-6.2.0\lib\qwt.lib 
	 -$(DEL_FILE) C:$(INSTALL_ROOT)\Qwt-6.2.0\lib\$(TARGET)
	-$(DEL_DIR) C:$(INSTALL_ROOT)\Qwt-6.2.0\lib 


