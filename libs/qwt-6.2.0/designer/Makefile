####### Install

install_target: all FORCE
	@if not exist C:$(INSTALL_ROOT)\Qwt-6.2.0\plugins\designer mkdir C:$(INSTALL_ROOT)\Qwt-6.2.0\plugins\designer & if not exist C:$(INSTALL_ROOT)\Qwt-6.2.0\plugins\designer exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) C:$(INSTALL_ROOT)\Qwt-6.2.0\plugins\designer\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT)\Qwt-6.2.0\plugins\designer\$(TARGET)
	-$(DEL_DIR) C:$(INSTALL_ROOT)\Qwt-6.2.0\plugins\designer 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

